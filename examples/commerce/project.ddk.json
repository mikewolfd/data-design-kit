{
  "specVersion": "0.1",
  "kind": "project",
  "id": "urn:example:commerce-project",
  "version": "1.0.0",
  "artifacts": {
    "orders": {
      "kind": "dataset",
      "path": "datasets/commerce.odcs.json",
      "object": "orders",
      "catalogId": "urn:example:commerce:dataset:orders",
      "role": "source_record"
    },
    "customers": {
      "kind": "dataset",
      "path": "datasets/commerce.odcs.json",
      "object": "customers",
      "catalogId": "urn:example:commerce:dataset:customers",
      "role": "source_record"
    },
    "daily-revenue": {
      "kind": "dataset",
      "path": "datasets/commerce.odcs.json",
      "object": "daily_revenue",
      "catalogId": "urn:example:commerce:dataset:daily-revenue",
      "role": "derived"
    },
    "read-orders": {
      "kind": "component",
      "path": "components/read-orders.ddk.json"
    },
    "summarize": {
      "kind": "component",
      "path": "components/summarize.ddk.json"
    },
    "review-adjustments": {
      "kind": "component",
      "path": "components/review-adjustments.ddk.json"
    },
    "daily-revenue-design": {
      "kind": "design",
      "path": "designs/daily-revenue.ddk.json"
    },
    "order-preview-design": {
      "kind": "design",
      "path": "designs/order-preview.ddk.json"
    },
    "reviewed-revenue-design": {
      "kind": "design",
      "path": "designs/reviewed-revenue.ddk.json"
    },
    "amount-cents": {
      "kind": "definition",
      "path": "definitions/amount-cents.json"
    },
    "commerce-policy": {
      "kind": "policy",
      "path": "policies/commerce.ddk.json"
    },
    "commerce-product": {
      "kind": "product",
      "path": "catalog/product.odps.json"
    }
  },
  "imports": {},
  "requiredChecks": [
    "core.documents",
    "core.references",
    "core.graph",
    "core.calls",
    "core.datasets",
    "core.policies"
  ],
  "catalog": {
    "id": "urn:example:commerce:catalog",
    "ports": [
      {
        "product": "commerce-product",
        "direction": "input",
        "port": "orders",
        "version": "1.0.0",
        "dataset": "orders"
      },
      {
        "product": "commerce-product",
        "direction": "input",
        "port": "customers",
        "version": "1.0.0",
        "dataset": "customers"
      },
      {
        "product": "commerce-product",
        "direction": "output",
        "port": "daily-revenue",
        "version": "1.0.0",
        "dataset": "daily-revenue"
      }
    ],
    "relationships": [
      {
        "id": "urn:example:commerce:relationship:customer",
        "source": {
          "dataset": "orders",
          "paths": [
            [
              {
                "field": "customer_id"
              }
            ]
          ]
        },
        "target": {
          "dataset": "customers",
          "paths": [
            [
              {
                "field": "customer_id"
              }
            ]
          ]
        },
        "match": "equal",
        "cardinality": "many_to_one",
        "scope": "version_pair",
        "resolution": "unresolved_allowed",
        "meaning": "Match each order to its customer region. An unmatched order contributes no row to the revenue calculation.",
        "nulls": "reject"
      }
    ],
    "recipes": [
      {
        "id": "urn:example:commerce:recipe:daily-revenue",
        "sql": "transforms/revenue.sql",
        "dialect": "datafusion",
        "inputs": {
          "orders": "orders",
          "customers": "customers"
        },
        "relationships": [
          "urn:example:commerce:relationship:customer"
        ],
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "resultDataset": "daily-revenue",
        "title": "Calculate daily revenue by date and region",
        "notes": [
          "Group example orders by order date and customer region, excluding cancelled orders and orders without a matching customer. This query recalculates totals from its inputs."
        ]
      },
      {
        "id": "urn:example:commerce:recipe:checked-revenue",
        "sql": "catalog/queries/read-revenue.sql",
        "dialect": "datafusion",
        "inputs": {
          "daily_revenue": "daily-revenue"
        },
        "relationships": [],
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "resultDataset": "daily-revenue",
        "title": "Read the saved daily revenue result",
        "notes": [
          "Read the existing daily revenue result. This query does not recalculate totals or rerun checks. It does not specify record order."
        ]
      }
    ]
  }
}
