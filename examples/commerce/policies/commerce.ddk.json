{
  "specVersion": "0.1",
  "kind": "policy",
  "id": "urn:example:commerce-policy",
  "version": "1.0.0",
  "rules": [
    {
      "id": "revenue-grain",
      "check": "row-identity",
      "dataset": "daily-revenue"
    },
    {
      "id": "revenue-quality-fields",
      "check": "quality-fields",
      "dataset": "daily-revenue"
    },
    {
      "id": "required-order-fields",
      "check": "fields-exist",
      "dataset": "orders",
      "fields": [
        "order_id",
        "amount_cents"
      ]
    },
    {
      "id": "dataset-status",
      "check": "vocabulary",
      "artifact": "orders",
      "pointer": "/status",
      "allowed": [
        "draft",
        "active"
      ]
    }
  ]
}
