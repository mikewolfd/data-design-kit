{
  "specVersion": "0.1",
  "kind": "project",
  "id": "urn:example:layered:resolved",
  "version": "1.0.0",
  "artifacts": {
    "stations": {
      "kind": "dataset",
      "path": "stations.odcs.json",
      "object": "stations",
      "catalogId": "urn:example:layered:dataset:stations",
      "role": "derived",
      "origin": "model",
      "model": {
        "id": "example-site-matcher",
        "version": "1.0.0",
        "configurationSha256": "51b188b877b257b0439b28c9be9e8713292bfb9f4221da36e9e5b421abb5046b",
        "review": "spot_checked",
        "reviewer": "Example reviewer"
      }
    },
    "resolve-stations": {
      "kind": "component",
      "path": "resolve-stations.ddk.json"
    },
    "stations-product": {
      "kind": "product",
      "path": "stations.odps.json"
    }
  },
  "imports": {
    "source": {
      "path": "../source/project.ddk.json"
    }
  },
  "requiredChecks": [
    "core.documents",
    "core.references",
    "core.graph",
    "core.calls",
    "core.datasets",
    "core.policies"
  ],
  "catalog": {
    "id": "urn:example:layered:resolved:catalog",
    "relationships": [
      {
        "id": "urn:example:layered:relationship:station-readings",
        "source": {
          "dataset": "stations",
          "paths": [
            [
              {
                "field": "station_code"
              }
            ]
          ]
        },
        "target": {
          "dataset": "source/readings",
          "paths": [
            [
              {
                "field": "station_code"
              }
            ]
          ]
        },
        "match": "equal",
        "cardinality": "one_to_many",
        "scope": "version_pair",
        "resolution": "unresolved_allowed",
        "nulls": "skip",
        "meaning": "Readings reported under a resolved station code."
      }
    ]
  }
}
