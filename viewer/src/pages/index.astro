---
import Workspace from '../components/Workspace';
import '../styles/workspace.css';
import '../styles/query-lab.css';
import '../styles/workflows.css';
import '../features/prepared-view/prepared-view.css';
import { configuredViewerTheme } from '../server/theme';
import { themeStyles } from '../lib/theme';
const theme = await configuredViewerTheme();
---
<!doctype html>
<html lang="en" style={themeStyles(theme)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find datasets, understand their fields and limitations, and explore available records." />
    <meta name="color-scheme" content="light" />
    <title>{theme.brand.name} · {theme.brand.tagline}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Workspace theme={theme} client:only="react"><p slot="fallback" class="boot" role="status">Opening the catalog…</p></Workspace>
    <noscript>JavaScript is required to browse this catalog.</noscript>
  </body>
</html>
