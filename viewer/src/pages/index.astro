---
import Workspace from '../components/Workspace';
import '../styles/workspace.css';
import '../features/prepared-view/prepared-view.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find datasets, understand their fields and limitations, and explore available records." />
    <meta name="color-scheme" content="light" />
    <title>Data catalog · DDK</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Workspace client:only="react"><p slot="fallback" class="boot" role="status">Opening the catalog…</p></Workspace>
    <noscript>JavaScript is required to browse this catalog.</noscript>
  </body>
</html>
