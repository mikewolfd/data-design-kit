---
import Workspace from '../components/Workspace';
import '../styles/workspace.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore exact data versions, definitions, relationships, and evidence in Data Design Kit catalogs." />
    <meta name="color-scheme" content="light" />
    <title>DDK · Data workspace</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Workspace client:only="react"><p slot="fallback" class="boot" role="status">Opening the data workspace…</p></Workspace>
    <noscript>This interactive data workspace needs JavaScript. Catalog files remain available through the configured owner.</noscript>
  </body>
</html>
