{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/adapter.schema.json",
  "title": "DDK 0.1 adapter",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "adapter"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "status": {
      "enum": [
        "experimental-unverified",
        "qualified"
      ]
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "distributionSha256": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "$ref": "common.schema.json#/$defs/group"
          },
          "standards": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "facets": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "exact",
                "checked",
                "unsupported",
                "unknown"
              ]
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "executionMode": {
            "enum": [
              "bounded_job",
              "managed_operation"
            ]
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "requestKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reconciliation": {
            "enum": [
              "supported",
              "unsupported"
            ]
          },
          "artifactFormats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "semanticProfiles": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/semanticProfile"
            },
            "minItems": 1
          },
          "nativeReferenceSchemes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "qualityAccess": {
            "enum": [
              "files",
              "native",
              "files-and-native"
            ]
          }
        },
        "required": [
          "group",
          "standards",
          "operations",
          "facets",
          "limitations",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "executionMode": {
                  "const": "managed_operation"
                }
              },
              "required": [
                "executionMode"
              ]
            },
            "then": {
              "required": [
                "backend",
                "requestKinds",
                "reconciliation"
              ],
              "properties": {
                "reconciliation": {
                  "const": "supported"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "group": {
                  "enum": [
                    "runtime.job",
                    "runtime.managed"
                  ]
                }
              },
              "required": [
                "group"
              ]
            },
            "then": {
              "required": [
                "executionMode",
                "backend",
                "requestKinds",
                "reconciliation",
                "artifactFormats",
                "semanticProfiles"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "group": {
                  "const": "runtime.job"
                }
              },
              "required": [
                "group"
              ]
            },
            "then": {
              "properties": {
                "executionMode": {
                  "const": "bounded_job"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "group": {
                  "const": "runtime.managed"
                }
              },
              "required": [
                "group"
              ]
            },
            "then": {
              "properties": {
                "executionMode": {
                  "const": "managed_operation"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "status",
    "profiles",
    "tools",
    "capabilities"
  ],
  "additionalProperties": false
}
