{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/common.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^/?[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "format": "uri"
      },
      "additionalProperties": true
    },
    "parameterSchema": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            },
            "additionalProperties": {
              "const": false
            }
          },
          "required": [
            "type",
            "properties",
            "additionalProperties"
          ]
        }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/alias"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "step": {
              "$ref": "common.schema.json#/$defs/alias"
            },
            "output": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "required": [
            "step",
            "output"
          ],
          "additionalProperties": false
        }
      ]
    },
    "datasetOrigin": {
      "description": "Whose assertion a dataset's content is. `derived` is read for older projects and reported as unknown detail.",
      "enum": [
        "publisher",
        "third_party",
        "rule",
        "human",
        "model",
        "derived"
      ]
    },
    "modelMethod": {
      "description": "How a model produced a dataset's values: the model, its version, a digest of the prompt or configuration, and the human review it has had.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configurationSha256": {
          "$ref": "#/$defs/digest"
        },
        "review": {
          "enum": [
            "unreviewed",
            "spot_checked",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "argument": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": true
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "required": [
            "parameter"
          ],
          "additionalProperties": false
        }
      ]
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "pointer"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z0-9-]+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "common.schema.json#/$defs/location"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/location"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "location"
      ],
      "additionalProperties": false
    },
    "runtimeIdentity": {
      "type": "object",
      "properties": {
        "scheme": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    },
    "semanticProfile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "$ref": "common.schema.json#/$defs/semanticProfile"
        }
      },
      "required": [
        "format",
        "semantics"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "entrypoint"
            ]
          }
        },
        {
          "required": [
            "entrypoint"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "sql"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "dialect",
              "path"
            ]
          }
        }
      ]
    },
    "nativeVersion": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "schemeVersion": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "digestAlgorithm": {
          "enum": [
            "sha256",
            "blake3"
          ]
        },
        "reference": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "runtime",
        "scheme",
        "schemeVersion",
        "namespace",
        "digestAlgorithm",
        "reference"
      ],
      "additionalProperties": false,
      "description": "The selected reference scheme owns the native reference shape. Core checks this wrapper only; the runtime validates the native reference, schema interpretation, and protection. This draft supports one declared native digest algorithm per scheme instance."
    },
    "fieldMapping": {
      "type": "object",
      "properties": {
        "logicalName": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "engineName": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "logicalType": {
          "type": "string",
          "minLength": 1
        },
        "physicalType": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "nativeFieldId": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "logicalName",
        "engineName",
        "position",
        "logicalType",
        "physicalType",
        "nullable"
      ],
      "additionalProperties": false
    },
    "nativeReadV1": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/nativeVersion"
        },
        "schemaIdentity": {
          "$ref": "common.schema.json#/$defs/runtimeIdentity"
        },
        "fields": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/fieldMapping"
              },
              {
                "required": [
                  "nativeFieldId"
                ]
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "version",
        "schemaIdentity",
        "fields"
      ],
      "additionalProperties": false
    },
    "nativeRead": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/nativeReadV1"},
        {"$ref": "common.schema.json#/$defs/nativeReadV2"}
      ]
    },
    "nativeReadV2": {
      "type": "object",
      "properties": {
        "profile": {"const": "urn:ddk:docspec:source-arrow:2"},
        "version": {"$ref": "common.schema.json#/$defs/nativeVersion"},
        "schemaIdentity": {"$ref": "common.schema.json#/$defs/runtimeIdentity"},
        "schema": {
          "type": "object",
          "properties": {
            "fields": {"type": "array", "items": {"type": "object"}},
            "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "required": ["fields", "metadata"],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "path": {"$ref": "catalog.schema.json#/$defs/fieldPath"},
              "nativeFieldPath": {
                "type": "array", "minItems": 1, "maxItems": 16,
                "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              },
              "position": {"type": "integer", "minimum": 0}
            },
            "required": ["path", "nativeFieldPath", "position"],
            "additionalProperties": false
          }
        }
      },
      "required": ["profile", "version", "schemaIdentity", "schema", "fields"],
      "additionalProperties": false,
      "description": "Explicit v2 canonical public source-view observation. The selected adapter validates the complete recursive Arrow schema and every field ID/path. Original schema, physical table/snapshot and broader native views are not established by this record."
    },
    "toolIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "distributionSha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "evidenceRecord": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "declaration",
                "implementation",
                "plan",
                "native-report",
                "dataset-snapshot",
                "fixture",
                "mapping"
              ]
            },
            "path": {
              "$ref": "common.schema.json#/$defs/path"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "attributes": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dataset-snapshot"
            },
            "nativeVersion": {
              "$ref": "common.schema.json#/$defs/nativeVersion"
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "attributes": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "nativeVersion"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reuseRecord": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "computationKey": {
          "$ref": "common.schema.json#/$defs/runtimeIdentity"
        },
        "semantics": {
          "$ref": "common.schema.json#/$defs/semanticProfile"
        },
        "qualificationKey": {
          "$ref": "common.schema.json#/$defs/runtimeIdentity"
        },
        "candidate": {
          "$ref": "common.schema.json#/$defs/nativeVersion"
        },
        "rules": {
          "$ref": "common.schema.json#/$defs/file"
        }
      },
      "required": [
        "authority",
        "computationKey",
        "semantics"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "qualificationKey": [
          "candidate",
          "rules"
        ]
      }
    },
    "qualificationRecord": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "common.schema.json#/$defs/nativeVersion"
        },
        "rules": {
          "$ref": "common.schema.json#/$defs/file"
        },
        "evaluator": {
          "$ref": "common.schema.json#/$defs/toolIdentity"
        },
        "semantics": {
          "$ref": "common.schema.json#/$defs/semanticProfile"
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unknown",
                  "not_run"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceRecord"
          },
          "minItems": 1
        }
      },
      "required": [
        "candidate",
        "rules",
        "evaluator",
        "semantics",
        "requiredChecks",
        "checks",
        "evidence"
      ],
      "additionalProperties": false
    },
    "runtimeOperation": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "bounded_job",
            "managed_operation"
          ]
        },
        "requestIdentity": {
          "$ref": "common.schema.json#/$defs/runtimeIdentity"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "reconciliation": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "execution": {
          "enum": [
            "not_submitted",
            "pending",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "not_requested"
          ]
        },
        "selection": {
          "enum": [
            "not_requested",
            "pending",
            "selected",
            "refused",
            "unknown"
          ]
        },
        "qualificationRequired": {
          "type": "boolean"
        },
        "acceptedQualification": {
          "$ref": "common.schema.json#/$defs/runtimeIdentity"
        },
        "candidate": {
          "$ref": "common.schema.json#/$defs/nativeVersion"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceRecord"
          },
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "publicationIntent": {
          "$ref": "common.schema.json#/$defs/publicationIntentObservation"
        }
      },
      "required": [
        "runtime",
        "mode",
        "requestIdentity",
        "reconciliation",
        "execution",
        "selection",
        "outputs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "managed_operation"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ],
            "properties": {
              "reconciliation": {
                "const": "supported"
              }
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "required": [
                      "publicationIntent"
                    ]
                  }
                },
                "then": {
                  "required": [
                    "qualificationRequired"
                  ]
                }
              }
            ]
          },
          "else": {
            "properties": {
              "selection": {
                "const": "not_requested"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "qualificationRequired"
                  ]
                },
                {
                  "required": [
                    "acceptedQualification"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection": {
                "const": "selected"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "required": [
              "candidate"
            ],
            "properties": {
              "execution": {
                "const": "succeeded"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "qualificationRequired": {
                "const": true
              },
              "selection": {
                "const": "selected"
              }
            },
            "required": [
              "qualificationRequired",
              "selection"
            ]
          },
          "then": {
            "required": [
              "acceptedQualification"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "execution": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "execution"
                ]
              },
              {
                "properties": {
                  "selection": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "selection"
                ]
              },
              {
                "required": [
                  "publicationIntent"
                ],
                "properties": {
                  "publicationIntent": {
                    "required": [
                      "outcome"
                    ],
                    "properties": {
                      "outcome": {
                        "const": "unknown"
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "const": "not_submitted"
              }
            },
            "required": [
              "execution"
            ]
          },
          "then": {
            "properties": {
              "selection": {
                "const": "not_requested"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "publicationIntent"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "managed_operation"
              },
              "execution": {
                "const": "not_requested"
              },
              "selection": {
                "const": "not_requested"
              },
              "outputs": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "qualificationRequired"
                  ]
                },
                {
                  "required": [
                    "candidate"
                  ]
                },
                {
                  "required": [
                    "acceptedQualification"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "execution": {
                "not": {
                  "const": "not_requested"
                }
              }
            }
          }
        }
      ]
    },
    "publicationIntentObservation": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "freeze",
            "inspect"
          ]
        },
        "outcome": {
          "enum": [
            "not_submitted",
            "succeeded",
            "not_found",
            "refused",
            "unknown"
          ]
        },
        "savedIntent": {
          "$ref": "common.schema.json#/$defs/nativeVersion"
        },
        "payloadState": {
          "enum": [
            "retained",
            "retired",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceRecord"
        }
      },
      "required": [
        "action",
        "outcome"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "savedIntent"
            ]
          },
          "then": {
            "required": [
              "payloadState",
              "evidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "payloadState"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "savedIntent",
              "payloadState",
              "evidence"
            ],
            "properties": {
              "payloadState": {
                "enum": [
                  "retained",
                  "retired"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "payloadState": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_found"
              }
            },
