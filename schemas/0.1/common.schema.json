{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/common.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^/?[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "format": "uri"
      },
      "additionalProperties": true
    },
    "parameterSchema": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            },
            "additionalProperties": {
              "const": false
            }
          },
          "required": [
            "type",
            "properties",
            "additionalProperties"
          ]
        }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/alias"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "step": {
              "$ref": "common.schema.json#/$defs/alias"
            },
            "output": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "required": [
            "step",
            "output"
          ],
          "additionalProperties": false
        }
      ]
    },
    "argument": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": true
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "required": [
            "parameter"
          ],
          "additionalProperties": false
        }
      ]
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "pointer"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z0-9-]+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "common.schema.json#/$defs/location"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/location"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "location"
      ],
      "additionalProperties": false
    }
  }
}
