{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/bindings.schema.json",
  "title": "DDK 0.1 bindings",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "bindings"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "design": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "parameters": {
      "type": "object"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "common.schema.json#/$defs/origin"
          },
          "dataset": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          },
          "format": {
            "enum": [
              "csv",
              "parquet",
              "arrow"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/file"
            },
            "minItems": 1
          }
        },
        "required": [
          "origin",
          "dataset",
          "format",
          "files"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/path"
      },
      "minItems": 0
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "design",
    "parameters",
    "data",
    "fixtures"
  ],
  "additionalProperties": false
}
