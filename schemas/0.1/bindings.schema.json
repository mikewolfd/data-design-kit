{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/bindings.schema.json",
  "title": "DDK 0.1 bindings",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "bindings"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "design": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "parameters": {
      "type": "object"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "common.schema.json#/$defs/origin"
          },
          "dataset": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          },
          "format": {
            "enum": [
              "csv",
              "parquet",
              "arrow"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/file"
            },
            "minItems": 1
          },
          "kind": {
            "enum": [
              "files",
              "native"
            ]
          },
          "nativeVersion": {
            "$ref": "common.schema.json#/$defs/nativeVersion"
          }
        },
        "required": [
          "origin",
          "dataset",
          "kind"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "files"
              }
            },
            "required": [
              "format",
              "files"
            ],
            "not": {
              "required": [
                "nativeVersion"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "native"
              }
            },
            "required": [
              "nativeVersion"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "files"
                  ]
                }
              ]
            }
          }
        ]
      },
      "minItems": 0
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/path"
      },
      "minItems": 0
    },
    "execution": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "bounded_job",
            "managed_operation"
          ]
        },
        "connection": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "requestKind": {
          "type": "string",
          "minLength": 1
        },
        "qualificationRequired": {
          "type": "boolean"
        },
        "rules": {
          "$ref": "common.schema.json#/$defs/file"
        }
      },
      "required": [
        "runtime",
        "adapter",
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "managed_operation"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "operationId",
              "requestKind",
              "qualificationRequired"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "operationId"
                  ]
                },
                {
                  "required": [
                    "requestKind"
                  ]
                },
                {
                  "required": [
                    "qualificationRequired"
                  ]
                },
                {
                  "required": [
                    "rules"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "qualificationRequired": {
                "const": true
              }
            },
            "required": [
              "qualificationRequired"
            ]
          },
          "then": {
            "required": [
              "rules"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "design",
    "parameters",
    "data",
    "fixtures"
  ],
  "additionalProperties": false
}
