{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/lock.schema.json",
  "title": "DDK 0.1 lock",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "lock"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions",
      "properties": {
        "urn:ddk:catalog:paired-public-view:1": {
          "type": "object",
          "properties": {
            "catalog": {"$ref": "common.schema.json#/$defs/identifier"},
            "publicLockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {"$ref": "common.schema.json#/$defs/identifier"},
                  "publicAlias": {"type": "string", "minLength": 1},
                  "localAlias": {"type": "string", "minLength": 1}
                },
                "required": ["id", "publicAlias", "localAlias"],
                "additionalProperties": false
              },
              "uniqueItems": true
            }
          },
          "required": ["catalog", "publicLockSha256", "datasets"],
          "additionalProperties": false
        }
      }
    },
    "project": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/path"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "role": {
            "enum": [
              "project",
              "artifact",
              "definition",
              "schema",
              "implementation",
              "binding",
              "data",
              "capability",
              "metadata",
              "disclosure-policy",
              "recipe"
            ]
          },
          "selection": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "distributionSha256": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nativeInputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nativeVersion"
      },
      "minItems": 0
    },
    "reuseRecords": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reuseRecord"
      },
      "minItems": 0
    },
    "catalogOptions": {
      "type": "object",
      "properties": {
        "audience": {
          "enum": [
            "local",
            "public"
          ]
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metadataAdapter": {
          "$ref": "common.schema.json#/$defs/toolIdentity"
        },
        "currentSelection": {
          "$ref": "catalog.schema.json#/$defs/selectionSelector"
        }
      },
      "required": [
        "audience",
        "exports"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "project",
    "files",
    "tools",
    "standards"
  ],
  "additionalProperties": false
}
