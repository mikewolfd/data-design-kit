{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/policy.schema.json",
  "title": "DDK 0.1 policy",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "policy"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "check": {
                "const": "fields-exist"
              },
              "dataset": {
                "$ref": "common.schema.json#/$defs/artifactRef"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "check",
              "dataset",
              "fields"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "check": {
                "const": "row-identity"
              },
              "dataset": {
                "$ref": "common.schema.json#/$defs/artifactRef"
              }
            },
            "required": [
              "id",
              "check",
              "dataset"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "check": {
                "const": "quality-fields"
              },
              "dataset": {
                "$ref": "common.schema.json#/$defs/artifactRef"
              }
            },
            "required": [
              "id",
              "check",
              "dataset"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "check": {
                "const": "vocabulary"
              },
              "artifact": {
                "$ref": "common.schema.json#/$defs/artifactRef"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(/.*)?$"
              },
              "allowed": {
                "type": "array",
                "items": true,
                "minItems": 1,
                "uniqueItems": true
              },
              "each": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "check",
              "artifact",
              "pointer",
              "allowed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "check": {
                "type": "string",
                "format": "uri",
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:"
              },
              "configuration": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "check",
              "configuration"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "rules"
  ],
  "additionalProperties": false
}
