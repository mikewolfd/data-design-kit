{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ddk/0.1/job.schema.json",
  "title": "DDK 0.1 job production",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "job"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "jobSpec": {
      "$ref": "common.schema.json#/$defs/path"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "outOfCatalogInputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      },
      "minProperties": 1
    },
    "outOfCatalogOutputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "qualityQueries": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dataset": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/name"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "dataset"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "specVersion",
    "kind",
    "id",
    "version",
    "jobSpec",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false
}
